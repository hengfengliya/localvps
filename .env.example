# localvps 的配置文件在 ~/.localvps/.env，控制台里改的设置都会写进去，一般不用手改。
# 下面是全部可用的键和默认值。环境变量临时覆盖时，名字前加 LOCALVPS_（如 LOCALVPS_PORT=19000）。

# 访问令牌。留空则首次启动自动生成并写回本文件。
ACCESS_TOKEN=
# 远程查看链接的密钥，留空自动生成
VIEW_KEY=

# 权限：readonly（只读工作目录）| workspace（读写工作目录）| full（任意路径 + 执行命令，等于整台电脑）
PERMISSION=workspace

# 工作目录。readonly / workspace 下 AI 只能碰这里；full 下是相对路径的基准和命令的默认 cwd。
WORKDIR=~/localvps-workspace

# 隧道：cf-quick（免注册，每次启动随机地址）| cloudflare（固定域名，需 CF_TUNNEL_TOKEN + PUBLIC_URL）| none（只监听本机）
TUNNEL=cf-quick
CF_TUNNEL_TOKEN=
PUBLIC_URL=

# 邀请服务：在控制台「隧道 → 邀请码」里填邀请链接后自动写入，一般不用手改。
# 绑定后这台电脑定时向邀请服务上报地址、在线状态、权限和访问令牌，邀请方可以远程连接。
HUB_URL=
HUB_CODE=
HUB_SECRET=

PORT=18787
HOST=127.0.0.1

# 运行期间阻止电脑休眠
KEEP_AWAKE=true

# 本机控制台端口（只监听 127.0.0.1，不经过隧道）；启动时自动在浏览器打开
PANEL_PORT=18788
OPEN_PANEL=true
